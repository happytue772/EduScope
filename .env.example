# ============================================================
# EduScope Environment Variables Example
# 실제 비밀번호, 개인 경로, Private Key는 이 파일에 저장하지 않습니다.
# 사용 시 .env로 복사한 뒤 환경에 맞게 값을 설정합니다.
# ============================================================

# ------------------------------------------------------------
# Oracle Database
# ------------------------------------------------------------
EDUSCOPE_DB_URL=jdbc:oracle:thin:@host.docker.internal:1521/orcl
EDUSCOPE_DB_USERNAME=change-me
EDUSCOPE_DB_PASSWORD=change-me
EDUSCOPE_WEB_PORT=8080

# ------------------------------------------------------------
# VMware Ubuntu / Hadoop SSH
# ------------------------------------------------------------
EDUSCOPE_HADOOP_SSH_HOST=change-me
EDUSCOPE_HADOOP_SSH_PORT=22
EDUSCOPE_HADOOP_SSH_USER=change-me

# Windows SSH 설정 경로
EDUSCOPE_SSH_KEY_PATH=C:/Users/your-windows-user/.ssh/eduscope_vm_ed25519
EDUSCOPE_SSH_KNOWN_HOSTS_PATH=C:/Users/your-windows-user/.ssh/known_hosts

# Ubuntu Hadoop 실행 환경
EDUSCOPE_HADOOP_ENV_SCRIPT=/home/user/bigdata/user-eduscope-hadoop.sh
EDUSCOPE_HADOOP_JAR=/home/user/eduscope-app/eduscope-mapreduce-1.0.0-SNAPSHOT.jar
EDUSCOPE_HADOOP_TIMEOUT_MINUTES=120

# ------------------------------------------------------------
# Logging / JVM
# ------------------------------------------------------------
EDUSCOPE_LOG_LEVEL=INFO
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
